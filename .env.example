# Direct Postgres (no Supabase JWT). Used to index memos, burns, SOL, and $ORBITX price for the UI.
# Prefer the Supabase session pooler or Vercel POSTGRES_URL_NON_POOLING / DATABASE_URL.
POSTGRES_URL_NON_POOLING=
DATABASE_URL=
POSTGRES_URL=
SUPABASE_DB_URL=
# Optional PostgREST leftovers. The on-chain feed does not use these.
# Server-only. Prefer the Dashboard "secret" key (sb_secret_...) or the legacy service_role JWT (eyJ...).
# Do not use the anon / publishable key here — notes writes will be rejected.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
# Daily Vercel cron (Hobby: once per day) hits /api/onchain/recover with Bearer CRON_SECRET.
CRON_SECRET=

